# Admin Authentication Secret (replace with a long, random secret)
ADMIN_PASSKEY=replace-with-a-long-random-secret

# Origin URL (development: http://localhost:5173, production: https://rajatsrivastav.dev)
SITE_URL=https://rajatsrivastav.dev

# Server Network Configuration
HOST=127.0.0.1
PORT=3001

# Persistent Storage for Posts
POSTS_FILE=data/posts.json

# Environment Mode ('development' for local HTTP, 'production' for HTTPS with Secure cookies)
NODE_ENV=production
