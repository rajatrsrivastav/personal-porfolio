# ==============================================================================
# Rajat Srivastav Portfolio - Environment Variables Template
# ==============================================================================

# Admin Authentication Secret (used for /admin passkey authentication & session HMAC signing)
ADMIN_PASSKEY=replace-with-a-long-random-secret

# Canonical Site Origin
# - Local development (Next.js default): http://localhost:3000
# - Production (Vercel): https://rajatsrivastav.dev
SITE_URL=http://localhost:3000

# Local Filesystem Storage (used for local development if Redis/KV is unset)
POSTS_FILE=data/posts.json

# Upstash Redis / Vercel KV Configuration (REQUIRED for durable CMS post storage on Vercel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
POSTS_REDIS_KEY=portfolio:posts

# Vercel KV Integration Aliases (automatically generated when linking Vercel KV / Upstash)
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=
REDIS_URL=
